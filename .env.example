# Application Environment
NODE_ENV=production
PORT=4000
APP_URL=https://your-service-name.onrender.com

# Database (Render PostgreSQL connection string; leave blank for local SQLite fallback)
DATABASE_URL=

# Admin Panel Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@SecurePassword2026!
JWT_SECRET=super-secure-jwt-secret-generate-random-token-here

# Cron Job Authentication (For Cron-job.org)
CRON_SECRET=my-cron-secret-token-38927492

# Operation Controls
DRY_RUN=false
DAILY_QUOTA=2

# AI Script & Metadata Provider (OpenAI or compatible provider like Groq/OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Text-To-Speech (Options: 'edge', 'openai', 'elevenlabs')
TTS_PROVIDER=edge
TTS_VOICE=en-US-ChristopherNeural
TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube Data API v3 (OAuth 2.0 Credentials from Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_TARGET_CHANNEL_ID=UCje0Deygks4X5w1oCRB-lew

# Object Storage (Options: 'local', 's3' for AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
